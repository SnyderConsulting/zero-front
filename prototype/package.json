{
  "name": "zero-front",
  "version": "0.2.0",
  "private": true,
  "productName": "Zero Front",
  "main": "desktop/main.cjs",
  "type": "module",
  "description": "Zero Front: an agent-first FPS research environment with deterministic simulation and software rendering.",
  "scripts": {
